# Base URL for the Django REST API.
# Vite exposes only variables prefixed with VITE_ to the browser bundle.
# Never put secrets here — this file is bundled into the client.
#
# In development: requests go through Vite's proxy (see vite.config.js),
# so the base URL is just /api — no hardcoded host needed.
# In production: set this to your actual API domain.
VITE_API_BASE_URL=/api

# App name used in page titles and branding
VITE_APP_NAME=PortfolioHub
